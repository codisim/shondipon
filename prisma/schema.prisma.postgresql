generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  role               UserRole @default(STUDENT)
  needPasswordChange Boolean  @default(true)
  isDeleted          Boolean  @default(false)
  admin              Admin?
  student            Student?
  teacher            Teacher?
  reviews            Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  profilePhoto String?
  address      String?
  gender       Gender
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [email], references: [email])

  notices Notice[]

  @@map("admins")
}

model Student {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String
  profilePhoto  String?
  address       String?
  isDeleted     Boolean    @default(false)
  admissionNo   String?
  batch         String?
  monthlyFee    Int
  admissionDate DateTime
  status        UserStatus @default(ACTIVE)
  gender        Gender

  user User @relation(fields: [email], references: [email])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  @@map("students")
}

model Teacher {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  phone        String
  profilePhoto String?
  address      String?
  experience   Int?
  gender       Gender
  designation  String?
  isDeleted    Boolean @default(false)

  user User @relation(fields: [email], references: [email])

  notices Notice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers") // Fixed from "doctors"
}

model Notice {
  id          String @id @default(uuid())
  title       String
  description String

  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notices")
}

model Payment {
  id     String        @id @default(uuid())
  month  String
  amount Int
  status PaymentStatus
  paidAt DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  @@map("payments")
}

model Review {
  id        String   @id @default(uuid())
  comment   String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  student   Student? @relation(fields: [studentId], references: [id])
  studentId String?
}

///////// enums /////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

